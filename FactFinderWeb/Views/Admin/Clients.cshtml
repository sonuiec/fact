@using FactFinderWeb.ModelsView
@using Microsoft.AspNetCore.Http;
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
  
    var role = HttpContextAccessor.HttpContext.Session.GetString("AdminUserRole") ?? "";

    ViewData["Title"] = "Clients";
    Layout = "~/Views/Shared/_LayoutAdminNew.cshtml";
    var currentSort = Context.Request.Query["sortOrder"];
    var selectedPlanType = Context.Request.Query["plantype"].ToString()?.ToLower();
     
    int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    int totalPages = (int)(ViewData["TotalPages"] ?? 1);
    string search = ViewData["Search"]?.ToString() ?? "";
    int serialNo = ((currentPage - 1) * 20) + 1;

    <script>
        $(document).on("change", ".manageby-dropdown", function () {

        var userid = $(this).data("userid");
        var advisorid = $(this).val();

        $.ajax({
        url: '/admin/UpdateAdvisor',
        type: 'POST',
        data: { id: userid, advisorid: advisorid },
        success: function (res) {
                 if (res.success) {
                alert("Financial Planner updated successfully!");
            setTimeout(function () {
                location.reload();
            }, 500); // ✅ half-second delay so alert is visible
        } else {
            alert("This Financial Planner is already assigned to any plan, so you should not change it.");
        }
        },
        error: function () {
            alert("This Financial Planner is already assigned to any plan, so you should not change it.");
        }
        });
        });

            // Store previous value before change
        $(document).on("focus", ".PlanStatus-dropdown", function () {
            $(this).data("previous", $(this).val());
        });

        $(document).on("change", ".PlanStatus-dropdown", function () {
            var dropdown = $(this);
            var previousValue = dropdown.data("previous");

            var profileid = dropdown.data("profileid");
            var Status = dropdown.val();

            $.ajax({
                url: '/admin/UpdateSStatus',
                type: 'POST',
                data: { profileid: profileid, Status: Status },

                success: function (res) {

                    // If server says NOT allowed → rollback
                    if (res.success === false) {

                        if (Status.toLowerCase().includes("assign")) {
                            alert("The Advisor is not assigned to Client.");
                        } else {
                            alert(res.message || "Error updating Status.");
                        }

                        dropdown.val(previousValue); // 🔥 ROLLBACK
                        return;
                    }

                    // Normal success
                    alert("Status updated successfully!");
                    setTimeout(function () {
                        location.reload();
                    }, 500);
                },

                error: function () {
                    // AJAX failure → rollback always
                    alert("The Advisor is not assigned to Client.");
                    dropdown.val(previousValue); // 🔥 ROLLBACK
                }
            });
        });

        function RenewPlan(id){

        $.ajax({
        url: '/admin/UpdateAdvisor',
        type: 'POST',
        data: { id: userid, advisorid: advisorid },
        success: function (res) {
                 if (res.success) {
                alert("Financial Planner updated successfully!");
            setTimeout(function () {
                location.reload();
            }, 500); // ✅ half-second delay so alert is visible
        } else {
            alert("This Financial Planner is already assigned to any plan, so you should not change it.");
        }
        },
        error: function () {
            alert("This Financial Planner is already assigned to any plan, so you should not change it.");
        }
        });
        }

        $(document).on("click", ".showexpireplan", function () {

            const parentRow = $(this).closest("tr");
            const uid = parentRow.data("uid");

            // TOGGLE: remove if already loaded
            if (parentRow.next().hasClass("child-row")) {
                parentRow.nextUntil(":not(.child-row)").remove();
                return;
            }
                $(this).find(".toggle-icon").toggleClass("rotate-up");

            $.ajax({
                url: '/user/GetclientsProfilebbyId/' + uid,
                type: 'GET',
                success: function (res) {

                    let html = '';

                    res.forEach(item => {
                        html += `
                        <tr class="child-row bg-gray-50">

                            <td style="padding-left:30px;">
                                ${item.uIdText}
                            </td>

                            <td>${item.userFullName}</td>
                            <td>${item.userEmail}</td>

                            <td>
                                <p style="font-size:11px;margin:0;">
                                    Type: <b>${item.userPlan}</b>
                                </p>
                                <p style="font-size:11px;margin:0;">
                                    Year: <b>${item.userPlanYear}</b>
                                </p>
                            </td>

                            <td>
                                <p style="font-size:11px;margin:0;">
                                    End Dt: ${formatDate(item.planEndDate)}
                                </p>
                                <p style="font-size:11px;margin:0;">
                                    Start Dt: ${formatDate(item.planStartDate)}
                                </p>
                            </td>

                            <td>${formatDate(item.userRegisterDate)}</td>
                            <td> <span class="px-2 py-1 bg-red-100 text-red-800 text-xs rounded-full"> ${item.planStatus}</span></td>

                            <td>
                             
                            </td>

                        </tr>`;
                    });

                    // INSERT AFTER CURRENT ROW
                    parentRow.after(html);
                },
                error: function () {
                    alert("Unable to load data.");
                }
            });
        });
                const formatDate = (dateStr) => {
          const d = new Date(dateStr);
          const day = String(d.getDate()).padStart(2, '0');
          const month = String(d.getMonth() + 1).padStart(2, '0');
          const year = d.getFullYear();
          return `${day}/${month}/${year}`;
        };

    </script>
}
<style>
    table{
        width:100%
    }
    table td {
        color: #111827; /* Tailwind gray-900 */
        font-size: .875rem;
        line-height: 1.25rem;
            text-align: left;
            padding: 0.75rem 0.75rem; /* py-3 px-3 */
    }

    table th {
        --tw-text-opacity: 1;
        color: rgb(107 114 128 / var(--tw-text-opacity, 1));
        font-size: 0.75rem;
        line-height: 1rem;
        font-weight: 500; 
        letter-spacing: 0.05em;
        text-transform: uppercase;
        text-align: left;
        padding: 0.75rem 0.75rem;
        text-align:left;
    }

