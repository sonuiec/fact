@using FactFinderWeb.ModelsView
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

@{
    ViewData["Title"] = "Overview";
    Layout = "~/Views/Shared/_LayoutAdminNew.cshtml";
   
}
@model List<PlanTypeMetricVM>
@{
    string userName = ViewBag.UserName ?? "";
    string userRole = ViewBag.UserRole ?? "";
    bool isAdmin = userRole == "superadmin";
}


<div class=" relative w-full h-screen overflow-y-auto bg-white-100">
   <div class=" relative w-full">
        <img src="https://admin.awaken.mainstream.co.in/static/media/homeBannner.2c3db03f3380f60a69f3.png" alt="homeBanner" class="mt-0 h-[25vh] object-cover object-center w-full">
      <div class="absolute inset-y-0 right-3 flex items-center justify-center pr-4">
         <div class="text-right">
              <p class="text-white text-2xl font-bold">
                    @(DateTime.Now.Hour < 12 ? "Good Morning" : "Hello") @userName

                </p>
                <p class="text-white text-sm opacity-80">
                    @(isAdmin ? "Administrator" : "Financial Planner")
                </p>
         
         </div>
      </div>
   </div>
   <div class="p-10">
      <div class="w-full mb-2">
         <p class="p-6 pb-3 flex flex-row items-center gap-3 font-semibold text-2xl">
            <span class="bg-yellow-200 flex items-center justify-center w-8 h-8 rounded-2xl">
               <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" class="text-blue-700 text-xl " height="1em" width="1em" xmlns="http://www.w3.org/2000/svg">
                  <path fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="32" d="m320 264-89.6 112-38.4-44.88"></path>
                  <path fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="32" d="M80 176a16 16 0 0 0-16 16v216c0 30.24 25.76 56 56 56h272c30.24 0 56-24.51 56-54.75V192a16 16 0 0 0-16-16zm80 0v-32a96 96 0 0 1 96-96h0a96 96 0 0 1 96 96v32"></path>
               </svg>
            </span>
                Overview
         </p>
         <p class="px-6 pb-3 text-sm text-gray-600">
             
                @(isAdmin
                                ? "Overview of all plan types across all clients"
                                : "Your assigned clients by plan type")

             </p>
      </div>
      <div class="w-full grid grid-cols-3 gap-8">

           @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="w-full shadow-xl rounded-lg bg-white p-4" style="box-shadow: rgba(0, 0, 0, 0.1) 0px 0px 30px 0px;" onclick="handleClick('@item.PlanType', @item.Count)">
            <p class="pb-3 text-xl">@item.PlanType</p>
            <div class="flex items-center justify-between">
                            <p class="text-4xl font-semibold">@item.Count</p>
               <img src="/static/media/fileDocument.fd3f95188d4d4da64fa3.png" alt="" class="w-10 h-auto text-secondary">
            </div>
         </div>

                }
            }
      
         </div>
      </div>
    
   </div>
</div>

  
<script>
    function handleClick(planType, count) {
        if (!planType) {
            alert("Invalid plan type");
            return;
        }

        if (count > 0) {
              window.location.href =
                '@Url.Action("Clients", "Admin")' +
                '?planType=' + encodeURIComponent(planType);
        } else {
            alert("No clients available for this plan type.");
        }
    }
</script>
