        @{
            int startPage = Math.Max(1, currentPage - 2);
            int endPage = Math.Min(totalPages, currentPage + 2);
        }

        <div class="flex justify-end mt-6">
            <nav aria-label="Page navigation">
                <ul class="flex items-center gap-2 text-sm">

                    <!-- First -->
                    <li>
                        <a href="?page=1&status=@selectedStatus&plantype=@selectedPlanType&search=@search"
                           class="px-3 py-1.5 rounded-md border
                   @(currentPage == 1 ? "pointer-events-none text-gray-400" : "text-blue-600 hover:bg-blue-50")">
                            First
                        </a>
                    </li>

                    <!-- Previous -->
                    <li>
                        <a href="?page=@(Math.Max(1, currentPage - 1))&status=@selectedStatus&plantype=@selectedPlanType&search=@search"
                           class="px-3 py-1.5 rounded-md border
                   @(currentPage == 1 ? "pointer-events-none text-gray-400" : "text-blue-600 hover:bg-blue-50")">
                            Previous
                        </a>
                    </li>

                    <!-- Dots before -->
                    @if (startPage > 1)
                    {
                        <li class="px-2 text-gray-400">…</li>
                    }

                    <!-- Page Numbers -->
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li>
                            <a href="?page=@i&status=@selectedStatus&plantype=@selectedPlanType&search=@search"
                               class="px-3 py-1.5 rounded-md border
                               @(i == currentPage
                                                                                          ? "bg-blue-600 text-white border-blue-600"
                                                                                          : "text-gray-700 hover:bg-gray-100")">
                                @i
                            </a>
                        </li>
                    }

                    <!-- Dots after -->
                    @if (endPage < totalPages)
                    {
                        <li class="px-2 text-gray-400">…</li>
                    }

                    <!-- Next -->
                    <li>
                        <a href="?page=@(Math.Min(totalPages, currentPage + 1))&status=@selectedStatus&plantype=@selectedPlanType&search=@search"
                           class="px-3 py-1.5 rounded-md border
                   @(currentPage == totalPages ? "pointer-events-none text-gray-400" : "text-blue-600 hover:bg-blue-50")">
                            Next
                        </a>
                    </li>

                    <!-- Last -->
                    <li>
                        <a href="?page=@totalPages&status=@selectedStatus&plantype=@selectedPlanType&search=@search"
                           class="px-3 py-1.5 rounded-md border
                   @(currentPage == totalPages ? "pointer-events-none text-gray-400" : "text-blue-600 hover:bg-blue-50")">
                            Last
                        </a>
                    </li>

                </ul>
            </nav>
        </div>

        <div id="pageLoader" class="loading" style="display:none;">
            <div class="loader"></div>
        </div>
