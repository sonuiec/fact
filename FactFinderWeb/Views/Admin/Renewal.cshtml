    <script>
        $(document).on("change", ".manageby-dropdown", function () {

        var userid = $(this).data("userid");
        var advisorid = $(this).val();

        $.ajax({
        url: '/admin/UpdateAdvisor',
        type: 'POST',
        data: { id: userid, advisorid: advisorid },
        success: function (res) {
                 if (res.success) {
                alert("Advisor updated successfully!");
            setTimeout(function () {
                location.reload();
            }, 500); // ✅ half-second delay so alert is visible
        } else {
            alert("This Advisor is already assigned to any plan, so you should not change it.");
        }
        },
        error: function () {
            alert("This Advisor is already assigned to any plan, so you should not change it.");
        }
        });
        });

            // Store previous value before change
        $(document).on("focus", ".PlanStatus-dropdown", function () {
            $(this).data("previous", $(this).val());
        });

        $(document).on("change", ".PlanStatus-dropdown", function () {
            var dropdown = $(this);
            var previousValue = dropdown.data("previous");

            var profileid = dropdown.data("profileid");
            var Status = dropdown.val();
            $("#pageLoader").show();
            $.ajax({
                url: '/admin/UpdateSStatus',
                type: 'POST',
                data: { profileid: profileid, Status: Status },

                success: function (res) {
                    $("#pageLoader").hide();
                    // If server says NOT allowed → rollback
                    if (res.success === false) {

                        if (Status.toLowerCase().includes("assign")) {
                            alert("The Advisor is not assigned to Client.");
                        } else {
                            alert(res.message || "Error updating Status.");
                        }

                        dropdown.val(previousValue); // 🔥 ROLLBACK
                        return;
                    }

                    // Normal success
                    alert("Status updated successfully!");
                    setTimeout(function () {
                        location.reload();
                    }, 500);
                },

                error: function () {
                    $("#pageLoader").hide();
                    // AJAX failure → rollback always
                    alert("The Advisor is not assigned to Client.");
                    dropdown.val(previousValue); // 🔥 ROLLBACK
                }
            });
        });

              function sendRenewal(id) {
                  $("#pageLoader").show();
            $.ajax({
                url: '/admin/SendRenewal/' + id,
                type: 'GET',
                success: function (res) {
                    if (res.success) {
                        $("#pageLoader").hide();
                        alert(res.message);
                        setTimeout(() => location.reload(), 500);
                    } else {
                        alert(res.message || "Renewal reminder sending failed.");
                        $("#pageLoader").hide();
                    }
                },
                error: function () {
                    $("#pageLoader").hide();
                    alert("Server error. Please try again later.");
                }
            });
        }




    </script>
}

<script>
