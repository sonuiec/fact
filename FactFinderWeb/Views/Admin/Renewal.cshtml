<script>





            let selectedId = 0;

             document.addEventListener("click", function (e) {
        const btn = e.target.closest(".renew-btn");
        if (!btn) return;

        // Assign values
        document.getElementById("mName").innerText = btn.dataset.name || "NA";
        document.getElementById("mEmail").innerText = btn.dataset.email || "NA";
        document.getElementById("mMobile").innerText = btn.dataset.mobile || "NA";
        document.getElementById("mDob").innerText = btn.dataset.dob || "NA";

        document.getElementById("mPlan").innerText = btn.dataset.plan || "NA";
        document.getElementById("mDuration").innerText = btn.dataset.duration || "NA";
        document.getElementById("mStart").innerText = btn.dataset.start || "NA";
        document.getElementById("mEnd").innerText = btn.dataset.end || "NA";

          document.getElementById("plantypes").value = btn.dataset.plan
          document.getElementById("plantDuration").value = btn.dataset.duration
           document.getElementById("planyears").value = btn.dataset.year
           document.getElementById("profileid").value = btn.dataset.profileid


        // Store profile id for submit
        document.getElementById("modal").dataset.profileid = btn.dataset.profileid;

        // Show modal
           document.querySelectorAll(".UpdateDetails").forEach(el => {
        el.classList.add("hidden");
    });
        document.getElementById("modal").classList.remove("hidden");
    });

        function openModal() {
        resetModalState();   // 🔥 reset first
        document.getElementById("modal").classList.remove("hidden");
    }

              function closeModal() {
        document.getElementById("modal").classList.add("hidden");
        resetModalState();   // 🔥 reset again
    }
            async function submitRenew() {

        const isChange = !document.getElementById("rbKeep").checked;


        const payload = {
            id: selectedId,
            oldProfileId: document.getElementById("profileid").value,
            planYear: document.getElementById("planyears").value,
            planType: document.getElementById("plantypes").value,
            planDuration: document.getElementById("plantDuration").value,
            isChange: isChange,
            ckAlertness: document.getElementById("ckAlertness").checked,
            ckKnowledge: document.getElementById("ckKnowledge").checked,
            ckPrecision: document.getElementById("ckPrecision").checked,
            ckInvestNow: document.getElementById("ckInvestNow").checked,

        };

        const res = await fetch('/Admin/createRenewPlan/0', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        const result = await res.json();
        if (result.success) {
            closeModal();
            location.reload();
        }
    }


       function togglePolicy(name,value) {

        if(name=="Change"){
              document.querySelectorAll(".UpdateDetails").forEach(el => {
        el.classList.remove("hidden");
    });
        }
         if(name=="Keep"){
        document.querySelectorAll(".UpdateDetails").forEach(el => {
        el.classList.add("hidden");
    });
        }
    }

        function resetModalState() {

        // 1. Reset radio
        document.getElementById("rbKeep").checked = true;

        // 2. Hide update section
        document.querySelectorAll(".UpdateDetails").forEach(el => {
            el.classList.add("hidden");
        });

        // 3. Clear inputs
        document.getElementById("plantypes").value = "";
        document.getElementById("planyears").value = "";
        document.getElementById("plantDuration").value = "";

        // 4. Clear text fields
        ["mName","mEmail","mMobile","mDob","mPlan","mDuration","mStart","mEnd"]
            .forEach(id => document.getElementById(id).innerText = "");

        document.getElementById("profileid").value = "";
    }



     $(document)
      .off("click", ".showexpireplan")
      .on("click", ".showexpireplan", function () {

        const parentRow = $(this).closest("tr");
        const uid = parentRow.data("uid");
        const icon = parentRow.find(".toggle-icon");

        // CLOSE
        if (parentRow.next().hasClass("child-row")) {
            parentRow.nextUntil(":not(.child-row)").remove();
            icon.removeClass("rotate-180");
            return;
        }

        icon.addClass("rotate-180");

        $.ajax({
            url: '/user/GetclientsProfilebbyId/' + uid,
            type: 'GET',
            success: function (res) {

                let html = '';

           res.forEach(item => {
        html += `
        <tr class="child-row bg-gray-50 border-l-4 border-blue-400">
            <td class="px-3 py-4 pl-10 text-sm text-gray-600">
               &nbsp;    &nbsp;${item.uIdText}
            </td>

            <td class="px-3 py-4 text-sm text-gray-900">
                 &nbsp; &nbsp;    <div class="font-medium">${item.userFullName}</div>
                <div class="text-xs text-gray-500">${item.userEmail}</div>
            </td>

            <td class="px-3 py-4 text-sm text-gray-900">
                ${item.userPlan}<br><span class="text-xs text-gray-500">${item.planDuration }</span>
            </td>

            

           

            <td class="px-3 py-4 text-sm text-gray-900">
                ${formatDate(item.planStartDate)}
            </td>

            <td class="px-3 py-4 text-sm text-gray-900">
                <div>
                    ${item.planEndDate ? formatDate(item.planEndDate) : 'NA'}

                </div>
            </td>

            <td class="px-3 py-4 text-sm">
                <span class="px-2.5 py-1 rounded-full text-xs font-medium
                    ${item.planStatus === 'Draft' ? 'bg-gray-100 text-gray-700' : 'px-2 py-1 bg-red-100 text-red-800 text-xs rounded-full'}">
                    ${item.planStatus}
                </span>
            </td>

            <td class="px-3 py-4 text-sm text-gray-600">
                ${item.advisorName || 'Unassigned'}
            </td>

            <td class="px-3 py-4 text-left text-sm font-medium">
                  <a href="${item.pdfPath}" target="_blank" class="text-green-600 hover:text-green-900 font-semibold">
                    Download
                </a>
            </td>
        </tr>`;
    });

                parentRow.after(html);
            }
        });
    });

                const formatDate = (dateStr) => {
          const d = new Date(dateStr);
          const day = String(d.getDate()).padStart(2, '0');
          const month = String(d.getMonth() + 1).padStart(2, '0');
          const year = d.getFullYear();
          return `${day}/${month}/${year}`;
        };
</script>

