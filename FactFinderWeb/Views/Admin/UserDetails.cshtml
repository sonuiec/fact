@using FactFinderWeb.ModelsView
@using Microsoft.AspNetCore.Http
@model UserProfileViewModel

@{
    ViewData["Title"] = "User Details";
    Layout = "~/Views/Shared/_LayoutAdminNew.cshtml";

    var AdminUserRole = Context.Session.GetString("AdminUserRole");
    AdminUserRole = string.IsNullOrEmpty(AdminUserRole) ? "advisor" : AdminUserRole;
}
 

<div class="p-6 bg-white rounded-lg shadow-md">
   <h2 class="text-2xl font-bold mb-6 text-gray-800">Profile</h2>
   <div class="max-w-2xl">
    
      <div class="bg-white border border-gray-200 rounded-lg p-6">
         <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-semibold text-gray-700">Personal Information</h3>
            <button id="editBtn" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">Edit Profile</button>
         </div>

            <form method="post" asp-action="UserDetails" asp-controller="Admin">
     <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4 space-y-4">

    <div>
        <label class="block text-sm font-medium text-gray-600 mb-1">Name</label>
                        <p class="view-mode text-gray-900">@Model.UserFullName</p>
            <input asp-for="UserFullName"
                           class="edit-mode hidden  px-3 py-2 border rounded-md" />
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-600 mb-1">Email</label>
                        <p class=" text-gray-900">@Model.UserEmail</p>
         <input asp-for="UserEmail"
                               class=" hidden  edit-mode px-3 py-2 border rounded-md" />
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-600 mb-1">Mobile Number</label>
                        <p class="view-mode text-gray-900">@Model.UserMobile</p>

            <input asp-for="UserMobile"
                           class="edit-mode hidden  px-3 py-2 border rounded-md" />
    </div>

    <div>
        @{
            var verificationStatus = Model.UserEmailVerification?.ToLower() != "yesverified"
                ? "Pending"
                : "Verified";
        }
        <label class="block text-sm font-medium text-gray-600 mb-1">Email Verified</label>
        <p class="text-gray-900">@verificationStatus</p>
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-600 mb-1">Active Status</label>
                        <p class="view-mode  text-gray-900">
            @(string.IsNullOrEmpty(Model.UserActiveStatus) || Model.UserActiveStatus == "0"
                ? "Inactive"
                : "Active")
        </p>

         <select asp-for="UserActiveStatus"
                                class="edit-mode hidden  rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500">
                            <option value="">Select</option>
                            <option value="1">Active</option>
                            <option value="0">Deactive</option>
                        </select>
                        @Html.ValidationMessageFor(m => m.UserActiveStatus, "", new { @class = "text-red-500 text-sm mt-1" })
    </div>


                  
</div>
<br />
                <div id="actionButtons" class="hidden mt-6 flex gap-3">
                    <button type="submit"
                            class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                        Save Changes
                    </button>

                    <button type="button"
                            id="cancelBtn"
                            class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                        Cancel
                    </button>
                </div>

</form>
      </div>
 
   </div>
</div>


<script>
    let isEditing = false;
     debugger
    const editBtn = document.getElementById("editBtn");
    const cancelBtn = document.getElementById("cancelBtn");
    const actionButtons = document.getElementById("actionButtons");

    const viewFields = document.querySelectorAll(".view-mode");
    const editFields = document.querySelectorAll(".edit-mode");

    function toggleEditMode(enable) {
        isEditing = enable;

        viewFields.forEach(el => el.classList.toggle("hidden", enable));
        editFields.forEach(el => el.classList.toggle("hidden", !enable));

        actionButtons.classList.toggle("hidden", !enable);
        editBtn.classList.toggle("hidden", enable);
    }

    editBtn.addEventListener("click", () => toggleEditMode(true));

    cancelBtn.addEventListener("click", () => {
        toggleEditMode(false);
        document.getElementById("profileForm").reset();
    });


</script>
