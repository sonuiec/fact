@using FactFinderWeb.ModelsView.AdminMV
@model MVLoginAdmin
@{
	ViewData["Title"] = "Admin Login";
}




<style>

	body {
		margin: 0;
		padding: 0;
		background-color: #0078D7;
		height: 100vh;
		overflow: hidden;
	}

	.container-box {
		display: flex;
		height: 100vh;
		align-items: center;
		justify-content: center;
	}

	.login-box {
		display: flex;
		width: 900px;
		height: 460px;
		background-color: white;
		box-shadow: 0 0 10px rgba(0,0,0,0.3);
	}

	.left-box {
		flex: 1;
		background: url('/images/login-pg-1.jpg') no-repeat center center;
		background-size: cover;
		position: relative;
		padding: 25px;
		color: white;
	}

		.left-box::before {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			background: rgba(0, 0, 0, 0.7);
		}

	.left-box-content {
		position: relative;
		z-index: 2;
	}

	.right-box {
		flex: 1;
		background: url('/images/login-pgadmin-2.jpg') no-repeat top center;
		background-size: contain;
		background-color: #92d7e4;
	}

	.form-control {
		margin-bottom: 2px;
	}

	.login-title {
		font-size: 2rem;
		margin-bottom: 8px;
	}

	.error-message {
		color: red;
		font-size: 0.9rem;
		margin-bottom: 15px;
	}

</style>
<div class="container-box">
	<div class="login-box">
		<!-- Left Login Section -->
		<div class="left-box">
			<div class="left-box-content">
				<div class="login-title">Admin Login</div>
				<form id="survey-form" method="post" asp-action="Login" asp-controller="Admin">

					<div class="row">
						<div class="d-flex justify-content-center">
							<div class="col-md-8">
								<div class="form-group">
									<label id="number-label" for="number">Email</label>
									<input type="email" class="form-control" id="Email" name="Email" asp-for="Email" placeholder="Email ID" required wfd-id="id2">
									@Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
								</div>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="d-flex justify-content-center">
							<div class="col-md-8  pt-2">
								<div class="form-group">
									<label asp-for="Password">Password</label>
									<input type="password" asp-for="Password" class="form-control" placeholder="Enter Password" value="" required maxlength="30" />
									@Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
								</div>
							</div>
						</div>

					</div>


					<div class="row">
						<div class="d-flex justify-content-center">
							<div class="col-md-8 pt-3" style="margin:0 auto;">
								<button type="submit" class="btn btn-primary btn-block">Submit</button>
							</div>
						</div>
					</div>

				

					<div class="row">
						<div class="d-flex justify-content-center">
							<div class="col-md-8" style="margin:0 auto;">
						 
								Forgot Password? <a href="/forgotpassword">Click Here </a>
							</div>
						</div>
					</div>

				</form>
			</div>
		</div>

		<!-- Right Visual Section -->
		<div class="right-box">
			<!-- Visual content handled via background image -->
		</div>
	</div>
</div>



@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}