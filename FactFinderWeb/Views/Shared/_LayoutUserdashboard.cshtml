@using Microsoft.AspNetCore.Http

@{
    var userId = Context.Session.GetString("UserId");
    var UserFullName = Context.Session.GetString("UserFullName");
    bool isLoggedIn = !string.IsNullOrEmpty(userId);
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FactFinder</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="~/css/common.css" rel="stylesheet" />
    <link href="~/css/sitenew.css" rel="stylesheet" />
<link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <style>
        .nav-link:hover {
            color: #87b5f9 !important;
            text-decoration: none !important;
            text-shadow: 0 0 1px #87b5f9; /* Subtle blue glow */
        }

        /* Prevent hover effect on "Welcome" item  style="background: url('/images/header.jpg') no-repeat  #8fd7e4 ;background-size: cover;height:8.3rem;" */
        .nav-item:first-child .nav-link:hover {
            color: inherit !important;
            text-shadow: none !important;
        }
 
        body{
            background-color: #f8f9fa !important
        }

        .bg-light {
            background-color: #fff !important;
        }
    </style>

    <script>


        function toggleRow(btn) {
            const icon = btn.querySelector('.toggle-icon');
            const mainRow = btn.closest('tr');
            const detailRow = mainRow.nextElementSibling;

            if (!detailRow || !detailRow.classList.contains('detail-row')) return;

            detailRow.classList.toggle('hidden');
            icon.classList.toggle('rotate-180');

              icon.classList.toggle("rotate-up");
        }
    </script>
    <style>
        table {
            width: 100%
        }

            table td {
                color: #111827; /* Tailwind gray-900 */
                font-size: .875rem;
                line-height: 1.25rem;
                text-align: left;
                padding: 0.75rem 0.75rem; /* py-3 px-3 */
            }

            table th {
                --tw-text-opacity: 1;
                color: rgb(107 114 128 / var(--tw-text-opacity, 1));
                font-size: 0.75rem;
                line-height: 1rem;
                font-weight: 500;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                text-align: left;
                padding: 0.75rem 0.75rem;
                text-align: left;
            }

            table tr {
                border-bottom: 1px solid #e5e7eb;
            }

        .absolute {
            position: absolute;
        }

        /* MVC validation error input */
        .input-validation-error {
            border-color: #ef4444 !important; /* Tailwind red-500 */
            background-color: #fef2f2; /* red-50 */
        }

            /* Focus state when error */
            .input-validation-error:focus {
                border-color: #ef4444 !important;
            }

            .field-validation-error, .input-validation-error:focus {
                color: #ef4444 !important;
            }


        .h-full {
            height: 54%;
        }

        .rotate-up {
            transform: rotate(180deg);
            transition: transform 0.3s ease;
        }

        td a {
            --tw-text-opacity: 1;
            color: #0056C1 !important;
            color: rgb(18 20 177 / var(--tw-text-opacity, 1)) !important;
            font-weight: 500;
        }
    </style>

</head>
<body>
    <header class="bg-white shadow">
        <div>
            <img src="/images/header.jpg" class="w-full h-32 object-cover" />
        </div>

        <nav class="flex items-center justify-between  py-3 border-t" style=" height: 56px;">
            <div></div>

            <ul class="flex items-center gap-6 text-sm">
                <li class="font-semibold text-gray-700">
                    Welcome, @UserFullName
                </li>
                <li>
                    <a href="/dashboard" class="text-gray-700 hover:text-blue-500">
                        Dashboard
                    </a>
                </li>
                <li>
                    <a href="/logout" class="text-gray-700 hover:text-red-500">
                        Logout
                    </a>
                </li>
            </ul>
        </nav>
    </header>


    <div class="max-w-7xl mx-auto px-4 py-6 bg-gray-50 min-h-screen">

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted d-flex justify-content-center align-items-center" style="padding: 5px 20px;">
        © 2025 Mainstream Investments Services Pvt. Ltd., All Rights Reserved.
    </footer>

    <div id="session-warning" style="display:none; position:fixed; top:20px; right:20px; background:#fff3cd; border:1px solid #ffeeba; padding:20px; z-index:10000; box-shadow:0 0 10px rgba(0,0,0,0.2);">
        <strong>Session Expiring Soon!</strong>
        <p>Your session will expire in 2 minutes. Do you want to stay logged in?</p>
        <button class="btn btn-warning" onclick="stayLoggedIn()">Stay Logged In</button>
    </div>

    
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>

    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!--session start-->
    <script>
        const sessionTimeout =30 * 60 * 1000; // 20 minutes
        const warningBefore = 2 * 60 * 1000;   // Warn 2 minutes before
        let warningTimeout, logoutTimeout;
        let warningShown = false;

        function resetTimers() {
            clearTimeout(warningTimeout);
            clearTimeout(logoutTimeout);
            warningShown = false;

            warningTimeout = setTimeout(showWarningPopup, sessionTimeout - warningBefore);
            logoutTimeout = setTimeout(() => {
                window.location.href = '/Login'; // Auto logout Account
            }, sessionTimeout);
        }

        function showWarningPopup() {
            warningShown = true;
            const popup = document.getElementById("session-warning");
            if (popup) popup.style.display = 'block';
        }

        function stayLoggedIn() {
            fetch('/KeepAlive/Ping', {
                method: 'GET',
                credentials: 'include'
            }).then(() => {
                resetTimers();
                const popup = document.getElementById("session-warning");
                if (popup) popup.style.display = 'none';
            });
        }

        // Detect activity to reset session
        ['click', 'mousemove', 'keydown'].forEach(event => {
            document.addEventListener(event, () => {
                if (!warningShown) resetTimers();
            });
        });

        // Start timers on load
        resetTimers();

        // Auto keep session alive every 15 min (in case no user activity)
        setInterval(() => {
            fetch('/KeepAlive/Ping', {
                method: 'GET',
                credentials: 'include'
            });
        }, 5 * 60 * 1000);
    </script>

    <!--session end-->
    @{
        /*
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <a class="navbar-brand mx-3" asp-area="" asp-controller="Home" asp-action="Index">Mainstream</a>
        */
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
