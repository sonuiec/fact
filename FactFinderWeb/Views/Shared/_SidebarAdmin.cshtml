@using FactFinderWeb.ModelsView
@using Microsoft.AspNetCore.Http;
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var currentRoute = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();
    var role = HttpContextAccessor.HttpContext.Session.GetString("AdminUserRole") ?? "";

}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        debugger;
        const toggle = document.getElementById("menuToggle");
        const leftmenuToggle = document.getElementById("LeftmenuToggle");
        const renderBody = document.getElementById("RenderBody");

        // 🔹 Restore state on page load
        const sidebarState = sessionStorage.getItem("sidebar-hidden");
        if (sidebarState === "true") {
            document.body.classList.add("sidebar-hidden");
            renderBody.className = "w-full transition-all duration-300";
            leftmenuToggle?.classList.remove("hidden");
        } else {
            document.body.classList.remove("sidebar-hidden");
            renderBody.className = "w-full ml-80 md:ml-64 transition-all duration-300";
            leftmenuToggle?.classList.add("hidden");
        }

        if (toggle) {
            toggle.addEventListener("click", function () {
                document.body.classList.toggle("sidebar-hidden");

                const isHidden = document.body.classList.contains("sidebar-hidden");
                sessionStorage.setItem("sidebar-hidden", isHidden);
                renderBody.removeAttribute("style");

                renderBody.className = "w-full transition-all duration-300";
                leftmenuToggle.classList.remove("hidden");
            });
        }

        if (leftmenuToggle) {
            leftmenuToggle.addEventListener("click", function () {
                document.body.classList.toggle("sidebar-hidden");

                const isHidden = document.body.classList.contains("sidebar-hidden");
                sessionStorage.setItem("sidebar-hidden", isHidden);
                renderBody.style.marginLeft = "169px";

                renderBody.className =
                    "w-full ml-80 md:ml-64 transition-all duration-300";
                leftmenuToggle.classList.add("hidden");
            });
        }
    });
</script>

 
<style>
    .top-3 {
        top: .75rem;
    }

    .right-3 {
        right: .75rem;
    }

    .absolute {
        position: absolute;
    }
</style>
